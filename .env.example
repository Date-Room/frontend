# ── Date Room web client (Vite SPA) ──────────────────────────────────────────
# This app talks directly to the deployed FastAPI backend (`/v1/…`) and to
# Supabase (auth + realtime). There is no longer a bundled Node server.

# Backend origin (no trailing slash). Callers add the `/v1` path themselves.
VITE_API_BASE_URL=https://backend-production-07bf.up.railway.app

# Supabase project — MUST be the same project the backend validates JWTs against.
# Project Settings → API → Project URL and the `anon` public key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: LiveKit ws URL fallback. Normally the backend returns the ws URL
# alongside each LiveKit token, so this is only a safety net.
# VITE_LIVEKIT_URL=wss://YOUR-PROJECT-REF.livekit.cloud
