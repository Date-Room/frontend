# nginx serving Vite SPA; proxies /api to the API container (leave VITE_API_URL unset).
FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.ts tailwind.config.ts postcss.config.ts tsconfig*.json components.json ./
COPY public ./public
COPY src ./src

# Same-origin `/api` in Docker Compose (nginx reverse proxy).
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
# Must match LIVEKIT_URL in .env.deploy (websocket URL baked into SPA at build).
ARG VITE_LIVEKIT_URL=
ENV VITE_LIVEKIT_URL=${VITE_LIVEKIT_URL}

RUN npm run build

FROM nginx:alpine
COPY docker/nginx/00-map.conf /etc/nginx/conf.d/00-map.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
