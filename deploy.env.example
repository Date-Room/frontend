# Copy to `.env.deploy` next to docker-compose.yml (never commit).
# Used by: `docker compose --env-file .env.deploy up`

# PostgreSQL — bundled Compose requires a strong DB password here.
POSTGRES_USER=dateroom
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=dateroom

# If PASSWORD_RESERVED_CHARS cause connection issues (@ # % …), replace the password here
# with a simpler one for the Compose Postgres service, OR URL-encode those characters inside
# a custom DATABASE_URL and use an override compose file to point `api` at external Postgres.

# Required in production API
JWT_SECRET=replace-with-long-random-string

# Browser origin for reset-password links (use your EC2 hostname or Elastic IP URL)
PASSWORD_RESET_APP_ORIGIN=http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN

# LiveKit — required for video rooms
LIVEKIT_URL=wss://your-ref.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional transaction email (password reset emails)
# RESEND_API_KEY=
# EMAIL_FROM=Date Room <noreply@yourdomain.com>
# EMAIL_APP_NAME=Date Room

# Optional ops
# ADMIN_API_SECRET=
# LOG_RESET_LINK=0
# DAILY_API_KEY=
